# Template env. File ini DI-TRACK GIT — isi placeholder saja, JANGAN nilai asli.
# Salin ke .env (gitignored) lalu isi nilai sebenarnya di sana.

# NEON — Dashboard Neon > Connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?uselibpqcompat=true&sslmode=require&channel_binding=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?uselibpqcompat=true&sslmode=require&channel_binding=require

# NEXTAUTH — generate secret: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# CRON — auth header /api/cron/*. Generate: openssl rand -base64 32
# Nilai wajib sama persis di Vercel > Project Settings > Environment Variables.
CRON_SECRET=

# GOOGLE SSO (opsional)
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# Kosongkan keduanya untuk menonaktifkan tombol SSO Google di halaman login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# WEB PUSH / PWA — generate sekali:
#   npx web-push generate-vapid-keys
# Salin output-nya ke sini. NEXT_PUBLIC_* aman di frontend (public key),
# VAPID_PRIVATE_KEY RAHASIA — jangan commit ke git.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Email yang muncul di header push request (format mailto:)
VAPID_SUBJECT=mailto:admin@promap.id

# DEMO & TESTING CREDENTIALS
NEXT_PUBLIC_DEMO_EMAIL=hendra.sobat@promap.id
NEXT_PUBLIC_DEMO_PASSWORD=
DEMO_PASSWORD=
TEST_PASSWORD=
